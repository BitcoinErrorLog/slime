{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slime record v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "slime-record/1"
    },
    "origin": {
      "type": "string",
      "pattern": "^pubky://[ybndrfg8ejkmcpqxot1uwisza345h769]{52}/pub/[^?#]+$",
      "maxLength": 8192
    },
    "operation": {
      "enum": [
        "put",
        "delete"
      ]
    },
    "content_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "parents": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "format",
    "origin",
    "operation",
    "content_sha256",
    "parents"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "put"
          }
        }
      },
      "then": {
        "properties": {
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "content_sha256": {
            "type": "null"
          }
        }
      }
    }
  ]
}
