{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slime observation v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "slime-observation/1"
    },
    "origin": {
      "type": "string",
      "format": "uri",
      "maxLength": 8192
    },
    "operation": {
      "enum": [
        "put",
        "delete",
        "unavailable"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "observer": {
      "type": "string",
      "pattern": "^[ybndrfg8ejkmcpqxot1uwisza345h769]{52}$"
    },
    "source_cursor": {
      "type": "string",
      "maxLength": 4096
    },
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_./-]+$"
      }
    }
  },
  "required": [
    "format",
    "origin",
    "operation",
    "source"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "put"
          }
        }
      },
      "then": {
        "required": [
          "content_sha256"
        ]
      },
      "else": {
        "not": {
          "required": [
            "content_sha256"
          ]
        }
      }
    }
  ]
}
