{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slime slice v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "slime-slice/1"
    },
    "provider": {
      "$ref": "urn:slime:schema:common#/$defs/key"
    },
    "as_of": {
      "$ref": "urn:slime:schema:common#/$defs/time"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:slime:schema:common#/$defs/scope"
      }
    },
    "through": {
      "$ref": "urn:slime:schema:common#/$defs/seq"
    },
    "entries": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "urn:slime:schema:common#/$defs/entry"
      }
    },
    "grant": {
      "$ref": "urn:slime:schema:common#/$defs/grant"
    }
  },
  "required": [
    "format",
    "provider",
    "grant",
    "as_of",
    "scopes",
    "through",
    "entries"
  ],
  "additionalProperties": false
}
