{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slime set v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "slime-set/1"
    },
    "files": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_./-]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "blake3": {
            "$ref": "urn:slime:schema:common#/$defs/hash"
          },
          "origin": {
            "type": "string",
            "format": "uri",
            "maxLength": 8192
          }
        },
        "required": [
          "path",
          "bytes",
          "blake3"
        ],
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "previous": {
      "$ref": "urn:slime:schema:common#/$defs/hash"
    }
  },
  "required": [
    "format",
    "files"
  ],
  "additionalProperties": false
}
