{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slime home statement v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "slime-home/1"
    },
    "identity": {
      "$ref": "urn:slime:schema:common#/$defs/key"
    },
    "home": {
      "$ref": "urn:slime:schema:common#/$defs/key"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issued_at": {
      "$ref": "urn:slime:schema:common#/$defs/time"
    },
    "grant": {
      "$ref": "urn:slime:schema:common#/$defs/grant"
    }
  },
  "required": [
    "format",
    "identity",
    "home",
    "sequence",
    "issued_at",
    "grant"
  ],
  "additionalProperties": false
}
